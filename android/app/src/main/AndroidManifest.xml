<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Biometric authentication permissions -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    
    <!-- Android Auto permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--Android Auto   -->
    <uses-permission android:name="com.google.android.car.permission.CAR_APP_TESTING" />
    
    <!-- NFC permissions -->
    <uses-permission android:name="android.permission.NFC" />
    
    <application
        android:label="Nexus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- Garage Home Screen Widget -->
        <receiver
            android:name=".GarageWidgetProvider"
            android:exported="true"
            android:label="@string/garage_widget_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.mahanadhi.nexus.ACTION_LOG_FUEL" />
                <action android:name="com.mahanadhi.nexus.ACTION_VIEW_GARAGE" />
                <action android:name="com.mahanadhi.nexus.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/garage_widget_info" />
        </receiver>
        
        <!-- Quick Transaction Home Screen Widget -->
        <receiver
            android:name=".QuickTransactionWidgetProvider"
            android:exported="true"
            android:label="@string/quick_transaction_widget_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.mahanadhi.nexus.ACTION_ADD_EXPENSE" />
                <action android:name="com.mahanadhi.nexus.ACTION_ADD_INCOME" />
                <action android:name="com.mahanadhi.nexus.ACTION_VIEW_TRANSACTIONS" />
                <action android:name="com.mahanadhi.nexus.ACTION_REFRESH_TRANSACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_transaction_widget_info" />
        </receiver>
        
        <!-- Balance Overview Home Screen Widget -->
        <receiver
            android:name=".BalanceWidgetProvider"
            android:exported="true"
            android:label="@string/balance_widget_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.mahanadhi.nexus.ACTION_VIEW_DASHBOARD" />
                <action android:name="com.mahanadhi.nexus.ACTION_VIEW_ACCOUNTS" />
                <action android:name="com.mahanadhi.nexus.ACTION_REFRESH_BALANCE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/balance_widget_info" />
        </receiver>
        
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Android Auto support metadata -->
        <meta-data
            android:name="com.google.android.gms.car.APPLICATION"
            android:resource="@xml/automotive_app_desc" />

        <!-- Android Auto Car App Service -->
        <service
            android:name=".NexusCarAppService"
            android:exported="true"
            android:permission="androidx.car.app.ACCESS_CAR_APP">
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="1" />
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- For URL launching -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- For email -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
