rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped data
    match /users/{userId} {
      // 1) Global User Profiles: needed for family/sharing features
      allow read: if request.auth != null;

      // 2) User can update only their own profile doc
      allow write: if request.auth != null && request.auth.uid == userId;

      // 3) All current/future subcollections under /users/{uid}/...
      //    covers: tasks, task_templates, transactions, accounts, categories, loans, goals, etc.
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Legacy/root-level collections (read-only)
    match /subscriptions/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /investments/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /cryptos/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}