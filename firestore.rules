rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-scoped collections (accounts, transactions within user documents)
    match /users/{userId} {
            // Backups subcollection - users can only access their own backup
            match /backups/{backupId} {
              allow read, write: if request.auth != null && request.auth.uid == userId;
              // Allow access to backup versions subcollection
              match /versions/{versionId} {
                allow read, write: if request.auth != null && request.auth.uid == userId;
              }
            }
      // Accounts subcollection (if needed)
      match /accounts/{accountId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
      }

      // Debts subcollection
      match /debts/{debtId} {
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
      }
      // ...existing code...
    }


    // ...existing code...

    // Subscriptions collection - users can only access their own subscriptions
    match /subscriptions/{subscriptionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // Investments collection - users can only access their own investments (Mutual Funds)
    match /investments/{investmentId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // Cryptos collection - users can only access their own crypto holdings
    match /cryptos/{cryptoId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
  }
}
