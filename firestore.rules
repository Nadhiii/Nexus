rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents and all user-scoped subcollections.
    match /users/{userId} {
      // The app uses this query to find family/user accounts. Keep profile
      // reads authenticated-only until public profile fields are separated.
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);

      // Covers accounts, transactions, budgets, goals, debts, subscriptions,
      // investments, bikes/entries/trips, backups, family data, knowledge,
      // notifications, and NBox audit records.
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Challans are currently stored at the root level by ChallanService.
    // Queries must include where('userId', isEqualTo: auth.uid).
    match /challans/{challanId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow get, list: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // Read-only legacy documents used by LegacyDataMigrationService.
    // New data belongs under /users/{uid}/... and cannot be written here.
    match /investments/{documentId} {
      allow get, list: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /subscriptions/{documentId} {
      allow get, list: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /goals/{documentId} {
      allow get, list: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}